<file path="Object/Sampah/Script/sampah_added.gd">
extends Node3D

@onready var bangunan_sampah := preload("res://Object/Sampah/bangunan_sampah.tscn")
@export var kapasitasi_maksimum_sampah: int = 15
@export var target_spawn: Node3D 
@export var antrian_sampah: int = 0:
	set(value):
		var nilai_lama = antrian_sampah
		
		# Batasi agar nilai baru tidak membuat total sampah melebihi kapasitas maksimum
		var total_sampah_saat_ini = get_jumlah_sampah_aktif()
		var sisa_kapasitas = kapasitasi_maksimum_sampah - total_sampah_saat_ini
		
		# Clamp nilai antrian agar aman
		antrian_sampah = clamp(value, 0, sisa_kapasitas)
		
		# Jangan jalankan setter jika node belum masuk ke Scene Tree
		if not is_inside_tree():
			return
			
		# Jika sebelumnya antrian 0 dan sekarang bertambah, jalankan lagi proses spawn-nya
		if nilai_lama == 0 and antrian_sampah > 0:
			mulai_proses_spawn()

@export var maximum_pos_x: float = 204.249
@export var minimum_pos_x: float = -211.055
@export var maximum_pos_y: float = 157.79
@export var minimum_pos_y: float = -155.321

var hasil_asli: bool = false
var sedang_spawn: bool = false 

func _ready() -> void:
	if antrian_sampah > 0:
		mulai_proses_spawn()

func desicion_raycaster() -> bool:
	var hasil: bool = true
	for i in range($Raycaster.get_child_count()):
		var ray = $Raycaster.get_child(i)
		if ray is RayCast3D and not ray.is_colliding():
			hasil = false
			break
	return hasil

func _on_area_3d_area_entered(area: Area3D) -> void:
	if not area.is_in_group("collision_checkers"):
		hasil_asli = false

func _on_area_3d_area_exited(area: Area3D) -> void:
	if not area.is_in_group("collision_checkers"):
		hasil_asli = true

# Fungsi untuk menghitung berapa banyak sampah yang saat ini sudah ada di target_spawn
func get_jumlah_sampah_aktif() -> int:
	if target_spawn != null:
		return target_spawn.get_child_count()
	return 0

func mulai_proses_spawn() -> void:
	if sedang_spawn: 
		return
	sedang_spawn = true
	
	while antrian_sampah > 0:
		# Pengecekan ganda: Jika kapasitas maksimum sudah tercapai di tengah jalan, hentikan proses spawn
		if get_jumlah_sampah_aktif() >= kapasitasi_maksimum_sampah:
			#print("Kapasitas maksimum sampah tercapai! Spawn dihentikan.")
			antrian_sampah = 0 # Kosongkan sisa antrian
			break

		await cari_posisi_valid()
		
		var instans_sampah = bangunan_sampah.instantiate()
		
		if target_spawn != null:
			target_spawn.add_child(instans_sampah)
			instans_sampah.position = self.global_position
			# instans_sampah.scale = Vector3(1, 1, 1) # Uncomment jika ukuran masih bermasalah
			
		antrian_sampah -= 1
		#print("Sisa antrian sampah: ", antrian_sampah, " | Total sampah aktif: ", get_jumlah_sampah_aktif())
		
		await get_tree().create_timer(0.1).timeout

	sedang_spawn = false
	#print("Proses spawn selesai.")

func cari_posisi_valid() -> void:
	var posisi_valid: bool = false
	
	while not posisi_valid:
		var random_x = randf_range(minimum_pos_x, maximum_pos_x)
		var random_y = randf_range(minimum_pos_y, maximum_pos_y)
		
		self.global_position.x = random_x
		self.global_position.z = random_y 
		
		hasil_asli = true
		
		await get_tree().physics_frame
		await get_tree().physics_frame
		
		if hasil_asli and desicion_raycaster():
			posisi_valid = true
		else:
			posisi_valid = false

func _on_start_timeout() -> void:
	pass
</file>

<file path="Object/Sampah/Script/timer_modal.gd">
extends Timer



func _on_timeout() -> void:
	var parent = get_parent()
	if parent:
		# Cek apakah nilai saat ini sudah mencapai atau melebihi batas maksimum
		if parent.item_value >= parent.maximum_item_value:
			stop() # Menghentikan Timer
			# queue_free() # Uncomment jika ingin nodenya langsung dihapus
		else:
			parent.item_value += 5
			
			# Pengecekan ekstra setelah ditambah, jika tembus batas, set ke max & stop timer
			if parent.item_value >= parent.maximum_item_value:
				parent.item_value = parent.maximum_item_value
				stop()
</file>

<file path="UI/Prefabs/BuildingSelectButton/Script/building_select_button.gd">
extends Control

@export_group("Konfigurasi Dasar")
@export var id_building: int
@export var nama_bangunan: String
@export var price_bangunan: int = 1000
@export var harga_beli_item: int
@export var control_parent: Marker3D
@export var offset_y: float = 300.0
@export var hoverd_disabled: bool = false

@export_group("Tekstur")
@export var gambar_bangunan: CompressedTexture2D
@export var gambar_input: CompressedTexture2D
@export var gambar_output: CompressedTexture2D

@export_group("Tipe Bangunan")
@export var is_building: bool = false
@export var is_generator_electric: bool = false
@export var is_store: bool = false

@export_group("Atribut Bangunan")
@export var is_selling_building: bool = false
@export var is_building_need_electric: bool = false
@export var is_generator_need_source: bool = false
# Catatan: Saya menyatukan is_level2_store dan is_store_level_2 menjadi satu variabel saja
@export var is_level_2: bool = false 

func _ready() -> void:
	setup_initial_ui()
	update_panel_visibility()
	Global.is_selecting.connect(reveal)
	visible= Global.currently_are_selecting
func reveal(is_reveal: bool)-> void:
	visible = is_reveal
# Dipisahkan ke fungsi sendiri agar _ready() tidak terlalu panjang
func setup_initial_ui() -> void:
	%Nama.text = nama_bangunan
	%BuildingTexture.texture = gambar_bangunan
	%InputTexture.texture = gambar_input
	%OutputTexture.texture = gambar_output
	%PriceLabel.text = str(price_bangunan)
	
	%InformationPanel.visible = false
	# Posisi panel lebih baik di-set saat hover saja agar akurat dengan ukuran layout akhir

func update_panel_visibility() -> void:
	# Menggunakan if-elif agar state tidak bertabrakan jika tidak sengaja tercentang dua
	if is_building:
		%PanelForBuilding.visible = true
		%PanelElectricity.visible = false
		%PanelStore.visible = false
		
		%Money.text = str(harga_beli_item)
		%OutputSell.texture = %OutputTexture.texture
		%InputTexture.visible = true
		%OutputTexture.visible = true
		%Forwad2.visible = true
		
		%Electricity.visible = is_building_need_electric
		%Adder.visible = is_building_need_electric
		
		%TokoLevel1.visible = !is_level_2
		%TokoLevel2.visible = is_level_2
		
	elif is_generator_electric:
		%PanelForBuilding.visible = false
		%PanelElectricity.visible = true
		%PanelStore.visible = false
		
		%ElectricityInputTexture.visible = is_generator_need_source
		%ForwadElectricity.visible = is_generator_need_source
		if is_generator_need_source:
			%ElectricityInputTexture.texture = gambar_input
			
	elif is_store:
		%PanelForBuilding.visible = false
		%PanelElectricity.visible = false
		%PanelStore.visible = true
		
		%TokoAdded1.visible = !is_level_2
		%TokoAdded2.visible = is_level_2

func _on_button_mouse_entered() -> void:
	if not hoverd_disabled:
		%InformationPanel.visible = true
		%InformationPanel.position = Vector2(
			global_position.x + ((size.x / 2) - (%InformationPanel.size.x / 2)),
			global_position.y - offset_y
		)

func _on_button_mouse_exited() -> void:
	if not hoverd_disabled:
		%InformationPanel.visible = false

func _on_button_pressed() -> void:
	if control_parent != null:
		# Menyimpan data ke parent
		control_parent.building_need_electicity = is_building_need_electric
		control_parent.id_input = id_building
		control_parent.input_price = price_bangunan
		control_parent.texture_input = %InputTexture.texture
		control_parent.texture_output = %OutputTexture.texture
		
		if is_selling_building:
			control_parent.harga_eceran = harga_beli_item
			#print("Harga beli barang: ", harga_beli_item, " | price_input: ", control_parent.harga_eceran)

[node name="TutorialPanel" parent="CanvasLayer/GameUIBuilder/TutorialGroup" unique_id=1872421202 node_paths=PackedStringArray("highlight_target") instance=ExtResource("72_v5oob")]
layout_mode = 1
dialog = Array[String](["Selamat datang di Sampahnesia, kota yang akan Bapak pimpin dan kelola mulai hari ini.", "Di bagian bawah ini, terdapat 3 panel tindakan utama yang dapat Bapak gunakan: [b]Membangun[/b], [b]Menghubungkan[/b], dan [b]Menghapus[/b].", "Mari kita lihat tumpukan sampah di depan kita. Kita akan memberdayakannya. Silakan buka [b]Panel Membangun[/b]."])
highlight_target = [null, null, null]

[node name="TutorialPanel2" parent="CanvasLayer/GameUIBuilder/TutorialGroup" unique_id=625658027 node_paths=PackedStringArray("highlight_target") instance=ExtResource("72_v5oob")]
layout_mode = 1
dialog = Array[String](["Pada panel ini, terdapat 4 kategori fasilitas: [b]Produksi[/b] (pengolahan sampah), [b]Energi[/b] (pembangkit listrik), [b]Toko[/b] (tempat penjualan), dan [b]Tanaman[/b] (penghijauan kota).", "Jika Bapak mengarahkan kursor ke fasilitas di kategori Produksi, Bapak dapat melihat detail keterangannya.", "Kita akan mencoba mengolah sampah menjadi hal bernilai. Silakan pilih [b]Lahan Pertanian[/b].", "Baris pertama menunjukkan bahan baku yang dibutuhkan serta hasilnya. Di sini, Lahan Pertanian membutuhkan sampah untuk menghasilkan gandum.", "Baris kedua menunjukan estimasi pendapatannya.", "Baris ketiga menunjukkan ke mana hasil gandum tersebut dapat dijual.", "Sekarang, silakan klik kanan Lahan Pertanian untuk memilih bangunan, kemudian klik kanan untuk meletakkan bangunan tersebut di area tanah yang kosong."])
highlight_target = []

[node name="TutorialPanel3" parent="CanvasLayer/GameUIBuilder/TutorialGroup" unique_id=58413537 node_paths=PackedStringArray("highlight_target") instance=ExtResource("72_v5oob")]
layout_mode = 1
dialog = Array[String](["Selanjutnya, buka [b]Panel Menghubungkan[/b]. Klik kiri dan tahan tumpukan sampah, lalu arahkan ke Lahan Pertanian tadi."])
highlight_target = [null]

[node name="TutorialPanel4" parent="CanvasLayer/GameUIBuilder/TutorialGroup" unique_id=1877235088 node_paths=PackedStringArray("highlight_target") instance=ExtResource("72_v5oob")]
layout_mode = 1
dialog = Array[String](["Bagus sekali! Sekarang sampah tersebut mulai diproses menjadi pupuk dan benih untuk menghasilkan gandum.", "Selanjutnya, kita akan memanfaatkan gandum tersebut sebagai pakan ternak. Buka kembali [b]Panel Membangun[/b], buat [b]Peternakan[/b], lalu hubungkan Lahan Pertanian ke Peternakan tersebut."])
highlight_target = [null, null]

[node name="TutorialPanel5" parent="CanvasLayer/GameUIBuilder/TutorialGroup" unique_id=1402583906 node_paths=PackedStringArray("highlight_target") instance=ExtResource("72_v5oob")]
layout_mode = 1
dialog = Array[String](["Bagus!!", "Langkah berikutnya adalah menjual hasil olahan kita. Buka [b]Panel Membangun[/b], pilih [b]Toko Kecil[/b], lalu hubungkan Peternakan ke Toko Kecil tersebut."])
highlight_target = [null, null]

[node name="TutorialPanel6" parent="CanvasLayer/GameUIBuilder/TutorialGroup" unique_id=1979274103 node_paths=PackedStringArray("highlight_target") instance=ExtResource("72_v5oob")]
layout_mode = 1
dialog = Array[String](["Perhatikan indikator di kanan atas layar, pendapatan kota mulai bertambah seiring berjalannya transaksi.", "Dana yang terkumpul dapat Bapak gunakan kembali untuk mengembangkan fasilitas pengolahan lain (ekonomi sirkular).", "Selain itu, Bapak dapat membuka lahan baru dengan menebang pohon. Buka [b]Panel Menghapus[/b], lalu coba tebang 2 atau 3 pohon di sekitar."])
highlight_target = [null, null, null]

[node name="TutorialPanel7" parent="CanvasLayer/GameUIBuilder/TutorialGroup" unique_id=19047868 node_paths=PackedStringArray("highlight_target") instance=ExtResource("72_v5oob")]
layout_mode = 1
dialog = Array[String](["Perlu diperhatikan, meskipun menebang pohon dapat memperluas area pembangunan, tindakan ini dapat meningkatkan kadar polusi udara kota.", "Oleh karena itu, pembukaan lahan harus tetap seimbang dengan penghijauan.", "Sekarang, buka [b]Panel Membangun[/b] dan tanam beberapa pohon baru."])
highlight_target = [null]

[node name="TutorialPanel8" parent="CanvasLayer/GameUIBuilder/TutorialGroup" unique_id=1768603524 node_paths=PackedStringArray("highlight_target") instance=ExtResource("72_v5oob")]
layout_mode = 1
dialog = Array[String](["Mohon atur strategi penggunaan lahan dengan bijak: tentukan mana area yang difokuskan untuk produksi dan mana yang dialokasikan untuk kelestarian lingkungan.", "Selanjutnya, mari kita kembangkan rantai produksi pengolahan sampah.", "Satu sumber sampah dapat dialirkan ke beberapa fasilitas pengolahan sekaligus. Silakan coba hubungkan sumber sampah tadi ke Lahan Pertanian kedua."])
highlight_target = [null, null, null]

[node name="TutorialPanel9" parent="CanvasLayer/GameUIBuilder/TutorialGroup" unique_id=2062447838 node_paths=PackedStringArray("highlight_target") instance=ExtResource("72_v5oob")]
layout_mode = 1
dialog = Array[String](["Sebuah fasilitas juga dapat menyalurkan hasilnya ke lebih dari satu tempat. Namun ingat, kecepatannya akan terbagi sehingga produksi menjadi sedikit lebih lambat.", "Silakan coba hubungkan 1 Lahan Pertanian ke 1 Peternakan dan 1 Pengolahan Kayu."])
highlight_target = [null, null]

[node name="TutorialPanel10" parent="CanvasLayer/GameUIBuilder/TutorialGroup" unique_id=353152739 node_paths=PackedStringArray("highlight_target") instance=ExtResource("72_v5oob")]
layout_mode = 1
dialog = Array[String](["Begitu pula sebaliknya, sebuah fasilitas dapat menerima suplai dari beberapa sumber. Namun, karena kapasitas penampungan terbatas, penerimaan barang tidak bisa terus-menerus. Silakan coba hubungkan 2 Lahan Pertanian ke 1 Peternakan."])
highlight_target = [null]

[node name="TutorialPanel11" parent="CanvasLayer/GameUIBuilder/TutorialGroup" unique_id=199403853 node_paths=PackedStringArray("highlight_target") instance=ExtResource("72_v5oob")]
layout_mode = 1
dialog = Array[String](["Terakhir, jika ada bangunan yang menghalangi jalan, salah posisi, atau tidak lagi dibutuhkan, Bapak dapat menghapusnya. Semua jalur penghubung pada bangunan tersebut juga akan otomatis terputus. Silakan coba hapus salah satu Lahan Pertanian yang telah dibuat."])
highlight_target = [null]

[node name="TutorialPanel12" parent="CanvasLayer/GameUIBuilder/TutorialGroup" unique_id=1585308614 node_paths=PackedStringArray("highlight_target") instance=ExtResource("72_v5oob")]
layout_mode = 1
dialog = Array[String](["Secara garis besar, alur utama tata kelola kota kita meliputi tiga langkah mendasar: [b]Membangun[/b], [b]Menghubungkan[/b], dan [b]Menghapus[/b].", "Apa penjelasan saya bisa dimengerti?", "Kalau begitu... Mari kita mulai bekerja."])
highlight_target = [null]

[node name="TutorialPanel13" parent="CanvasLayer/GameUIBuilder/TutorialGroup" unique_id=1068883268 instance=ExtResource("72_v5oob")]
layout_mode = 1
dialog = Array[String](["Lapor pak terdapat bangunan yang sedang rusak akibat banjir. Banjir ini akan sering terjadi apabila semakin buruknya kualitas lingkungan", "Bangunan yang menerima banjir mengalami kerusakan bangunan. Namun jangan khawatir pak, karena kita bisa melakukan reparasi bangunan", "pilih panel [b]Menghubungkan[/b] kemudian pilih bangunan yang mengalami kerusakan. Akan ada muncul tagihan perbaikan"])


[sub_resource type="GDScript" id="GDScript_va8i0"]
script/source = "extends Control

@onready var setting_Scnee = $Setting/SettingControl

func _ready():
	setting_Scnee.visible = false


func _on_play_pressed():
	Transition.change_scnee(\"res://Level/TestLevel/test_level.tscn\")


func _on_setting_pressed():
	setting_Scnee.visible = true


func _on_exit_pressed():
	get_tree().quit()
"

